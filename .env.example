# Telegram Bot API token from @BotFather
TG_BOT_TOKEN=123456:ABC-DEF...

# Channel to watch (numeric id, e.g. -100xxxxxxxxxx)
CHANNEL_ID=-1000000000000

# Linked discussion group (numeric id, -100xxxxxxxxxx for supergroup)
GROUP_ID=-1000000000000

# Sticker pack name (the part after t.me/addstickers/) and index in the pack
STICKER_SET=HotCherry
STICKER_INDEX=0

# Delay in seconds between post publication and the sticker comment
DELAY_SEC=10
